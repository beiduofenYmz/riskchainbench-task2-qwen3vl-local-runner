# The vLLM OpenAI-compatible endpoint running on the same server.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8000/v1

# Must match the vLLM --api-key value. Use a non-empty local secret.
LOCAL_OPENAI_API_KEY=replace-with-a-local-secret

# Must match vLLM --served-model-name.
QWEN_MODEL=Qwen/Qwen3-VL-8B-Instruct

# Optional: only set this when Tesseract is not on PATH.
# TESSERACT_ROOT=/absolute/path/to/portable-tesseract-root

# Conservative default for a single local 8B VLM server.
CASE_WORKERS=1
MATERIALIZE_WORKERS=4
